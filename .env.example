# ── AGRENES Environment Variables ──────────────────────────────
# Copy this to .env.local and fill in real values

# Supabase — get at https://supabase.com → your project → Settings → API
REACT_APP_SUPABASE_URL=https://your-project-id.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key-here

# Stripe — get at https://dashboard.stripe.com → Developers → API Keys
# Use pk_test_xxx for testing, pk_live_xxx for live
REACT_APP_STRIPE_PUBLIC_KEY=pk_live_your_publishable_key_here

# Your site URL (for Stripe redirects)
REACT_APP_SITE_URL=https://agrenes.co.uk
